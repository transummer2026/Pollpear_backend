DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json
x-user-id: 50

{
	"confirmation": "CONFIRMED"
}

### run the request above a second time -> 401 Unauthorized (soft-deleted, no longer resolves as a valid user)
DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json
x-user-id: 50

{
	"confirmation": "CONFIRMED"
}

### wrong confirmation phrase -> 400 Bad Request (zod literal mismatch)
DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json
x-user-id: 49

{
	"confirmation": "confirmed"
}

### missing confirmation field -> 400 Bad Request
DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json
x-user-id: 49

{}

### missing x-user-id header -> 401 Unauthorized
DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json

{
	"confirmation": "CONFIRMED"
}

### x-user-id with no matching user in DB -> 401 Unauthorized
DELETE http://localhost:3000/me HTTP/1.1
Content-Type: application/json
x-user-id: 999999

{
	"confirmation": "CONFIRMED"
}
