x-user-id: 2

{
	"title": "Best pizza topping?",
	"description": "Settling this once and for all",
	"type": "multiple_choice",
	"endsAt": "2026-12-31T23:59:59.000Z",
	"visibility": "public",
	"allowChangeVote": true,
	"isAnonymous": false,
	"hashtags": [ { "name": "food" }, { "name": "pizza" } ],
	"options": [
		{ "text": "Pineapple", "order": 0 },
		{ "text": "Pepperoni", "order": 1 },
		{ "text": "Mushroom", "order": 2 }
	]
}

